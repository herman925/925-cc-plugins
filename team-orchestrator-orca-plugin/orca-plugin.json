{
  "manifestVersion": 1,
  "id": "team-orchestrator",
  "publisher": "herman925",
  "name": "Team Orchestrator",
  "version": "0.1.24",
  "description": "Create team hierarchies and launch, name and brief agents through a bundled local worker and automatic runtime adapter.",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "contributes": {
    "panels": [
      {
        "id": "team",
        "title": "Team Orchestrator",
        "icon": "bot",
        "entry": "panel.html"
      }
    ],
    "commands": [
      {
        "id": "team.initialise",
        "title": "Team Orchestrator: Initialise local adapter",
        "context": "global"
      },
      {
        "id": "team.control",
        "title": "Team Orchestrator: Check local worker",
        "context": "global"
      }
    ],
    "events": [
      {
        "on": "worktree.created"
      },
      {
        "on": "agent.status.changed"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "notifications:show"
    }
  ],
  "main": "main.mjs"
}
