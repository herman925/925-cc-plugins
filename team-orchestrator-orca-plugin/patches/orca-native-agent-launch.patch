diff --git a/src/main/plugins/plugin-native-agent-launch.ts b/src/main/plugins/plugin-native-agent-launch.ts
new file mode 100644
--- /dev/null
+++ b/src/main/plugins/plugin-native-agent-launch.ts
@@ -0,0 +1,39 @@
+import { createHash } from 'node:crypto'
+import type { PluginHostServices } from './plugin-host-method-bindings'
+
+export type PluginAgentLaunch = {
+  requestId: string; workspaceKey: string; title: string; agent: 'codex' | 'claude';
+  model?: string; effort?: string; brief: string
+}
+export type PluginAgentLaunchReceipt = {
+  handle: string; title: string; executionHostId?: string; briefAccepted: boolean; warning?: string
+}
+export const pluginWorkspaceKey = (worktreeId: string): string =>
+  createHash('sha256').update(worktreeId).digest('hex')
+
+/** Native desktop launch; never delegates authority to an SSH-host CLI. */
+export async function createPluginAgentTerminal(
+  pluginId: string, params: PluginAgentLaunch, services: PluginHostServices
+): Promise<PluginAgentLaunchReceipt> {
+  const context = await services.resolveActiveWorktreeContext()
+  if (!context || pluginWorkspaceKey(context.worktreeId) !== params.workspaceKey) {
+    throw new Error('The focused workspace changed. No terminal was created by this call.')
+  }
+  if (!services.createAgentTerminal) throw new Error('Native agent launching is unavailable.')
+  const key = `native-launch:${params.requestId}`
+  const fingerprint = createHash('sha256').update(JSON.stringify(params)).digest('hex')
+  const existing = services.storage.get(pluginId, key) as
+    { fingerprint: string; receipt?: PluginAgentLaunchReceipt } | null
+  if (existing) {
+    if (existing.fingerprint !== fingerprint) throw new Error('Launch request identity conflicts with an existing request.')
+    if (existing.receipt) return existing.receipt
+    throw new Error('Earlier launch outcome is unknown. Inspect Orca; do not launch a duplicate.')
+  }
+  const intent = services.storage.set(pluginId, key, { fingerprint })
+  if (!intent.ok) throw new Error(intent.error)
+  // The journal intent is synchronous and precedes the first awaited mutation, fencing concurrent duplicates.
+  const receipt = await services.createAgentTerminal(context.worktreeId, params)
+  const saved = services.storage.set(pluginId, key, { fingerprint, receipt })
+  if (!saved.ok) return { ...receipt, warning: `Tab created, but its receipt could not be saved: ${saved.error}`.slice(0, 1000) }
+  return receipt
+}
